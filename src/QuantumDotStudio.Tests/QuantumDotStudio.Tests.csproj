  <ItemGroup>
    <ProjectReference Include="..\QuantumDotStudio.Core\QuantumDotStudio.Core.csproj" />
    <ProjectReference Include="..\QuantumDotStudio.Solver\QuantumDotStudio.Solver.csproj" />
    <ProjectReference Include="..\QuantumDotStudio.Renderer\QuantumDotStudio.Renderer.csproj" />
    <ProjectReference Include="..\QuantumDotStudio.Reports\QuantumDotStudio.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
