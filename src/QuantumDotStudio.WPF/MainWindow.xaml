<Window x:Class="QuantumDotStudio.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:vm="clr-namespace:QuantumDotStudio.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Quantum Dot Studio" Height="720" Width="1200">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Steuerleiste links -->
        <StackPanel Grid.Column="0" Margin="16">
            <TextBlock Text="Quantum Dot Studio" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

            <TextBlock Text="Material" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Simulation.Materials}"
                     SelectedItem="{Binding Simulation.SelectedMaterial}"
                     DisplayMemberPath="Name"
                     Margin="0,4,0,12" />

            <TextBlock Text="Radius (nm)" FontWeight="SemiBold" />
            <Slider Minimum="1" Maximum="10" Value="{Binding Simulation.Radius_nm, Mode=TwoWay}"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Margin="0,4,0,4" />
            <TextBlock Text="{Binding Simulation.Radius_nm, StringFormat='{}{0:F1} nm'}" Margin="0,0,0,4" />

            <Border Background="LightYellow" BorderBrush="DarkOrange" BorderThickness="1" Padding="8" CornerRadius="4"
                    Visibility="{Binding Simulation.HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,12">
                <TextBlock Text="{Binding Simulation.ValidationMessage}" TextWrapping="Wrap" Foreground="DarkRed" />
            </Border>

            <Button Content="Berechnen" Command="{Binding Simulation.RecalculateCommand}" Margin="0,0,0,12" />

            <Border Background="#1a1a2e" BorderBrush="#333355" BorderThickness="1" Padding="10" CornerRadius="4" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="3D-Ansicht" FontWeight="Bold" Foreground="#e0e0ff" Margin="0,0,0,8" />
                    <CheckBox Content="Atomgitter anzeigen" IsChecked="{Binding Simulation.ShowLattice}" Foreground="#e0e0ff" Margin="0,0,0,6" />
                    <CheckBox Content="Wahrscheinlichkeitswolke anzeigen" IsChecked="{Binding Simulation.ShowCloud}" Foreground="#e0e0ff" Margin="0,0,0,6" />

                    <TextBlock Text="Legende" FontWeight="SemiBold" Foreground="#e0e0ff" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding Simulation.LegendItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Rectangle Width="12" Height="12" Fill="{Binding Brush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Label}" Foreground="#e0e0ff" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button Content="LaTeX-Export" Command="{Binding Export.ExportCommand}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding Export.StatusMessage}" TextWrapping="Wrap" FontSize="11" Foreground="DarkGreen" Margin="0,0,0,16" />

            <Border Background="LightGray" Padding="8" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Ergebnisse" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Simulation.BandGapText}" />
                    <TextBlock Text="{Binding Simulation.WavelengthText}" />
                    <TextBlock Text="{Binding Simulation.AtomCountText}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Hauptansicht rechts -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8">
                <helix:HelixViewport3D x:Name="Viewport3D" ShowFrameRate="True" InfiniteSpin="False">
                    <helix:DefaultLights />
                    <ModelVisual3D x:Name="AtomModelHost" />
                </helix:HelixViewport3D>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,4,0">
                    <oxy:PlotView Model="{Binding Simulation.EnergyLevelPlot}" />
                </Border>

                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="4,0,0,0">
                    <oxy:PlotView Model="{Binding Simulation.SpectrumPlot}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
