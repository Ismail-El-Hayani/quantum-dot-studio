<Window x:Class="QuantumDotStudio.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:vm="clr-namespace:QuantumDotStudio.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Quantum Dot Studio" Height="720" Width="1200">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Steuerleiste links -->
        <StackPanel Grid.Column="0" Margin="16">
            <TextBlock Text="Quantum Dot Studio" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

            <TextBlock Text="Material" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Simulation.Materials}"
                     SelectedItem="{Binding Simulation.SelectedMaterial}"
                     DisplayMemberPath="Name"
                     Margin="0,4,0,12" />

            <TextBlock Text="Core/Shell-Modus" FontWeight="SemiBold" />
            <CheckBox Content="Shell aktiv (Core/Shell-Heterostruktur)" IsChecked="{Binding Simulation.UseShell}" Margin="0,4,0,6" />
            <StackPanel Visibility="{Binding Simulation.UseShell, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Shell-Material" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Simulation.Materials}"
                         SelectedItem="{Binding Simulation.SelectedShellMaterial}"
                         DisplayMemberPath="Name"
                         Margin="0,4,0,8" />
                <TextBlock Text="Schalendicke (nm)" FontWeight="SemiBold" />
                <Slider Minimum="0" Maximum="5" Value="{Binding Simulation.ShellThickness_nm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,4,0,4" />
                <TextBlock Text="{Binding Simulation.ShellThickness_nm, StringFormat='{}{0:F1} nm'}" Margin="0,0,0,8" />
            </StackPanel>

            <TextBlock Text="Radius (nm)" FontWeight="SemiBold" />
            <Slider Minimum="1" Maximum="10" Value="{Binding Simulation.Radius_nm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Margin="0,4,0,4" />
            <TextBlock Text="{Binding Simulation.Radius_nm, StringFormat='{}{0:F1} nm'}" Margin="0,0,0,4" />

            <Border Background="LightYellow" BorderBrush="DarkOrange" BorderThickness="1" Padding="8" CornerRadius="4"
                    Visibility="{Binding Simulation.HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,12">
                <TextBlock Text="{Binding Simulation.ValidationMessage}" TextWrapping="Wrap" Foreground="DarkRed" />
            </Border>

            <Button Content="Berechnen" Command="{Binding Simulation.RecalculateCommand}" Margin="0,0,0,12" />

            <Border Background="#1a1a2e" BorderBrush="#333355" BorderThickness="1" Padding="10" CornerRadius="4" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="3D-Ansicht" FontWeight="Bold" Foreground="#e0e0ff" Margin="0,0,0,8" />
                    <CheckBox Content="Atomgitter anzeigen" IsChecked="{Binding Simulation.ShowLattice}" Foreground="#e0e0ff" Margin="0,0,0,6" />
                    <CheckBox Content="Wahrscheinlichkeitswolke anzeigen (1S)" IsChecked="{Binding Simulation.ShowCloud}" Foreground="#e0e0ff" Margin="0,0,0,6" />
                    <CheckBox Content="1P-Zustand zusätzlich anzeigen" IsChecked="{Binding Simulation.ShowCloud1P}" Foreground="#e0e0ff" Margin="0,0,0,6" />
                    <Button Content="3D-Ansicht zurücksetzen" Click="Reset3DView_Click" Margin="0,0,0,8" />

                    <TextBlock Text="Legende" FontWeight="SemiBold" Foreground="#e0e0ff" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding Simulation.LegendItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Rectangle Width="12" Height="12" Fill="{Binding Brush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Label}" Foreground="#e0e0ff" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button Content="LaTeX-Export" Command="{Binding Export.ExportCommand}" Margin="0,0,0,4" />
            <CheckBox Content="Screenshot der 3D-Ansicht einbetten" IsChecked="{Binding Export.IncludeScreenshot}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding Export.StatusMessage}" TextWrapping="Wrap" FontSize="11" Foreground="DarkGreen" Margin="0,0,0,16" />

            <Border Background="LightGray" Padding="8" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Ergebnisse" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Simulation.BandGapText}" />
                    <TextBlock Text="{Binding Simulation.WavelengthText}" />
                    <TextBlock Text="{Binding Simulation.AtomCountText}" />
                    <TextBlock Text="{Binding Simulation.ShellInfoText}" TextWrapping="Wrap" Foreground="SteelBlue" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Hauptansicht rechts -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8">
                <helix:HelixViewport3D x:Name="Viewport3D"
                                     ShowFrameRate="True"
                                     InfiniteSpin="False"
                                     RotateGesture="LeftClick"
                                     PanGesture="RightClick"
                                     ShowCoordinateSystem="False"
                                     ShowViewCube="False"
                                     CameraMode="Inspect"
                                     ClipToBounds="True"
                                     Cursor="Cross">
                    <helix:DefaultLights />
                    <!-- Bindet das im Hintergrund-Thread vorgebaute (geFrorene) Modell:
                         der UI-Thread führt kein Mesh-Building mehr aus. -->
                    <ModelVisual3D x:Name="AtomModelHost" Content="{Binding Simulation.Pending3DModel}" />
                </helix:HelixViewport3D>
            </Border>

            <TabControl Grid.Row="1" Background="White">
                <TabItem Header="Energie">
                    <oxy:PlotView Model="{Binding Simulation.EnergyLevelPlot}" />
                </TabItem>
                <TabItem Header="Spektrum">
                    <oxy:PlotView Model="{Binding Simulation.SpectrumPlot}" />
                </TabItem>
                <TabItem Header="Bandprofil">
                    <oxy:PlotView Model="{Binding Simulation.BandProfilePlot}" />
                </TabItem>
                <TabItem Header="Sensor">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Sensor-Konfiguration links -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Funktionalisierung (Ligand)" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Sensor.Ligands}"
                                     SelectedItem="{Binding Sensor.SelectedLigand}"
                                     DisplayMemberPath="DisplayName"
                                     Margin="0,4,0,8" />
                            <TextBlock Text="{Binding Sensor.LigandInfo}" TextWrapping="Wrap" FontSize="11" Foreground="SteelBlue" Margin="0,0,0,10" />

                            <TextBlock Text="Analyt" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Sensor.Analytes}"
                                     SelectedItem="{Binding Sensor.SelectedAnalyte}"
                                     DisplayMemberPath="DisplayName"
                                     Margin="0,4,0,8" />
                            <TextBlock Text="{Binding Sensor.AnalyteInfo}" TextWrapping="Wrap" FontSize="11" Foreground="SteelBlue" Margin="0,0,0,10" />

                            <TextBlock Text="Konzentration / Aktivität (M)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Sensor.Concentration_M, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding Sensor.ConcentrationText}" FontSize="11" Foreground="Gray" Margin="0,0,0,10" />

                            <TextBlock Text="Rezeptor-Abstand über Ligand (nm)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Sensor.ReceptorOffset_nm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                            <TextBlock Text="FRET: Abstand ungebunden — extra (nm)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Sensor.DistanceUnboundExtra_nm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="FRET: Abstand gebunden — extra (nm)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Sensor.DistanceBoundExtra_nm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                        </StackPanel>

                        <!-- Antwort rechts -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Sensor.ResponseSummary}" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="12" Margin="4,0,4,8" />
                            <oxy:PlotView Grid.Row="1" Model="{Binding Sensor.ResponsePlot}" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Machbarkeit">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Anwendung + Bewertung auslösen -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Literatur-Design (Vorlage)" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Feasibility.SensorTemplates}"
                                     SelectedItem="{Binding Feasibility.SelectedSensorTemplate}"
                                     DisplayMemberPath="DisplayName"
                                     Margin="0,4,0,10" />

                            <TextBlock Text="Anwendungs-Template" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Feasibility.Templates}"
                                     SelectedItem="{Binding Feasibility.SelectedTemplate}"
                                     DisplayMemberPath="DisplayName"
                                     Margin="0,4,0,10" />

                            <TextBlock Text="Rezeptor K_D (M, leer = Direktdetektion)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Feasibility.ReceptorKd_M, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10" />

                            <Button Content="Machbarkeit bewerten" Padding="4"
                                    Command="{Binding Feasibility.EvaluateCommand}" />
                            <ProgressBar Visibility="{Binding Feasibility.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         IsIndeterminate="True" Height="6" Margin="0,6,0,0" />

                            <TextBlock Text="Hinweis: Ligand, Analyt und Konzentration stammen aus dem Sensor-Tab."
                                       TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- Ergebnis: Verdikt, Balken, Monte Carlo -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{Binding Feasibility.VerdictColor}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Feasibility.VerdictText}" Foreground="White" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Feasibility.ProbabilityText}" Foreground="White" FontSize="13" />
                                        <TextBlock Text="{Binding Feasibility.MonteCarloText}" Foreground="White" FontSize="11"
                                                   Visibility="{Binding Feasibility.HasMonteCarlo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Feasibility.Result.Factors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text="{Binding Weight, StringFormat=' (Gewicht {0:P0})'}" Foreground="Gray" />
                                                    <Run Text="{Binding ScorePercent, StringFormat=' — {0:F0} %'}" />
                                                </TextBlock>
                                                <ProgressBar Value="{Binding ScorePercent}" Maximum="100" Height="10" Margin="0,2,0,2" />
                                                <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" FontSize="11" Foreground="DarkRed" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Feasibility.Result.Decomposition}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Input}" Width="180" FontSize="11" />
                                                <ProgressBar Value="{Binding FractionPercent}" Maximum="100" Height="8" Width="200" />
                                                <TextBlock Text="{Binding FractionPercent, StringFormat=' {0:F0} %'}" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
